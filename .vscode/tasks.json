{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Fetch prices",
      "type": "shell",
      "command": "python",
      "args": ["scripts/fetch_prices.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Serve dashboard (port 8000)",
      "type": "shell",
      "command": "fuser -k 8000/tcp 2>/dev/null; python -m http.server 8000 --directory docs",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP.*",
          "endsPattern": "^.*$"
        }
      }
    }
  ]
}